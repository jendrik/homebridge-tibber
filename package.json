{
  "displayName": "Tibber",
  "name": "@jendrik/homebridge-tibber",
  "type": "module",
  "version": "0.1.5",
  "description": "Homebridge plugin for Tibber",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/jendrik/homebridge-tibber.git"
  },
  "bugs": {
    "url": "https://github.com/jendrik/homebridge-tibber/issues"
  },
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "keywords": [
    "homebridge-plugin",
    "tibber"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "homebridge": "^2.0.2",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "tibber-api": "^5.5.2"
  }
}
